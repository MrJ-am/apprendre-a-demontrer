name: Préparer la migration du style
on:
  push:
    branches: [migration/style-mrjam]
    paths: [.github/workflows/atelier-style.yml]
permissions:
  contents: read
jobs:
  reference:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/checkout@v4
        with:
          repository: MrJ-am/style-mrjam
          ref: 52ad33f881b50feef91d60915d17bae90abfc592
          path: .cache/style-mrjam
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Vérifier les sources avant toute transformation
        run: |
          set -euo pipefail
          npm ci
          npm test
          npm run build
      - name: Préparer un atelier hors ligne sans identifiants
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/atelier"
          git rev-parse HEAD > "$RUNNER_TEMP/atelier/commit.txt"
          git archive HEAD > "$RUNNER_TEMP/atelier/sources.tar"
          test "$(git -C .cache/style-mrjam rev-parse HEAD)" = 52ad33f881b50feef91d60915d17bae90abfc592
          git -C .cache/style-mrjam archive HEAD > "$RUNNER_TEMP/atelier/style.tar"
          node_modules/.bin/elm make src/Main.elm --output=/tmp/reference.js
          tar -czf "$RUNNER_TEMP/atelier/node_modules.tar.gz" node_modules
          tar -czf "$RUNNER_TEMP/atelier/elm-home.tar.gz" -C "$HOME" .elm
      - uses: actions/upload-artifact@v4
        with:
          name: atelier-style-reference
          path: ${{ runner.temp }}/atelier
          retention-days: 3
          if-no-files-found: error
